# ===========================================================================
# Aura 本地开发/演示配置模板（仅 debug 构建注入，release 不读）
# 用法：cp .env.example .env，然后填入你自己的值。.env 已 gitignore 不会提交。
# 构建时由 app/build.gradle.kts 读取 -> BuildConfig.ENV_* -> DebugConfigSeeder 预填。
# ===========================================================================

# ===== 云端 LLM（对话体）=====
# 默认启动的 Provider 和模型
# Provider 决定 baseUrl：GLM / KIMI / MODELSCOPE / LOCAL_QWEN
# - GLM:        https://open.bigmodel.cn/api/anthropic  (open.bigmodel.cn 申请)
# - KIMI:       https://api.kimi.com/coding
# - MODELSCOPE: https://api-inference.modelscope.cn     (魔搭，推荐比赛用)
# - LOCAL_QWEN: 本地 MNN，无需 key
LLM_PROVIDER=MODELSCOPE
LLM_MODEL=Qwen/Qwen3.5-397B-A17B

# 各 Provider 密钥（同时注入，切换时自动加载）
GLM_API_KEY=
MODELSCOPE_API_KEY=
KIMI_API_KEY=

# ===== 本地陪伴体（可选）=====
# Dream Loop 用的本地模型；留空=跟随主聊天模型
LOCAL_QWEN_MODEL=Qwen3.5-0.8B-MNN

# ===== MCP servers =====
# 高德地图（preset 型，只需 key，在 lbs.amap.com 申请 32 位 key）
MCP_AMAP_API_KEY=

# 自定义 MCP（魔搭广场 https://www.modelscope.cn/docs/mcp/intro 上的 server）
# 按 MCP_CUSTOM_<序号>_NAME / _URL / _TOKEN 填，序号 1..6 连续；name+url 都填才生效
# _TOKEN 留空 = 纯 URL 模式（魔搭/高德类）；填了 = 带 Authorization: Bearer <token>（瑞幸等需登录态的）
# 示例（纯 URL）：麦当劳
#   MCP_CUSTOM_1_NAME=麦当劳
#   MCP_CUSTOM_1_URL=https://mcp.api-inference.modelscope.net/xxx/mcp
#   MCP_CUSTOM_1_TOKEN=
# 示例（Bearer）：瑞幸
#   MCP_CUSTOM_2_NAME=瑞幸
#   MCP_CUSTOM_2_URL=https://gwmcp.lkcoffee.com/order/user/mcp
#   MCP_CUSTOM_2_TOKEN=登录后复制的Token
MCP_CUSTOM_1_NAME=
MCP_CUSTOM_1_URL=
MCP_CUSTOM_1_TOKEN=
MCP_CUSTOM_2_NAME=
MCP_CUSTOM_2_URL=
MCP_CUSTOM_2_TOKEN=
MCP_CUSTOM_3_NAME=
MCP_CUSTOM_3_URL=
MCP_CUSTOM_3_TOKEN=
MCP_CUSTOM_4_NAME=
MCP_CUSTOM_4_URL=
MCP_CUSTOM_4_TOKEN=
MCP_CUSTOM_5_NAME=
MCP_CUSTOM_5_URL=
MCP_CUSTOM_5_TOKEN=
MCP_CUSTOM_6_NAME=
MCP_CUSTOM_6_URL=
MCP_CUSTOM_6_TOKEN=

# ===== 预填策略 =====
# true=每次 debug 启动强制用 .env 覆盖 DataStore
# false（默认）=只在字段为空时填，不破坏运行时手改的值
ENV_FORCE_SEED=false
