<?xml version="1.0" encoding="utf-8"?>
<!--
  Aura Logo — ic_launcher_foreground
  viewBox: 108x108 (Android adaptive icon safe zone 72dp centered)
  Logo SVG 坐标系 200x200 → 缩放到108，scale=0.54，translate=(0,0)
  环半径 78*0.54=42.1，圆心 100*0.54=54
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- 不均匀渐变环：顺时针，右下最细→左上最粗 -->
    <path android:strokeColor="@color/brand_aura_violet" android:strokeWidth="10" android:fillColor="#00000000"
        android:strokeAlpha="0.50" android:strokeLineCap="butt"
        android:pathData="M178,100 A78,78 0 0,1 154.8,155.2"/>
    <path android:strokeColor="@color/brand_aura_violet" android:strokeWidth="14" android:fillColor="#00000000"
        android:strokeAlpha="0.60" android:strokeLineCap="butt"
        android:pathData="M154.8,155.2 A78,78 0 0,1 100,178"/>
    <path android:strokeColor="@color/brand_aura_violet" android:strokeWidth="20" android:fillColor="#00000000"
        android:strokeAlpha="0.70" android:strokeLineCap="butt"
        android:pathData="M100,178 A78,78 0 0,1 45.2,155.2"/>
    <path android:strokeColor="@color/brand_aura_violet" android:strokeWidth="26" android:fillColor="#00000000"
        android:strokeAlpha="0.78" android:strokeLineCap="butt"
        android:pathData="M45.2,155.2 A78,78 0 0,1 22,100"/>
    <path android:strokeColor="@color/brand_aura_violet" android:strokeWidth="30" android:fillColor="#00000000"
        android:strokeAlpha="0.85" android:strokeLineCap="butt"
        android:pathData="M22,100 A78,78 0 0,1 45.2,44.8"/>
    <path android:strokeColor="@color/brand_aura_violet" android:strokeWidth="26" android:fillColor="#00000000"
        android:strokeAlpha="0.78" android:strokeLineCap="butt"
        android:pathData="M45.2,44.8 A78,78 0 0,1 100,22"/>
    <path android:strokeColor="@color/brand_aura_violet" android:strokeWidth="18" android:fillColor="#00000000"
        android:strokeAlpha="0.62" android:strokeLineCap="butt"
        android:pathData="M100,22 A78,78 0 0,1 154.8,44.8"/>
    <path android:strokeColor="@color/brand_aura_violet" android:strokeWidth="13" android:fillColor="#00000000"
        android:strokeAlpha="0.52" android:strokeLineCap="butt"
        android:pathData="M154.8,44.8 A78,78 0 0,1 178,100"/>

    <!-- Aura 紫月牙（用 clip-path 近似：先画Aura圆，再用金圆路径覆盖背景色）-->
    <!-- Android Vector 不支持 mask，用 差集路径 近似月牙 -->
    <!-- 月牙弧路径：两圆交点计算
         Aura: cx=94,cy=100,r=30  你: cx=114,cy=116,r=38
         交点1≈(80.8, 72.4)  交点2≈(122.8, 128.0)
         紫月牙 = 从交点1沿Aura圆弧到交点2（小弧），再沿你圆弧反向回交点1
    -->
    <path android:fillColor="@color/brand_aura_violet" android:fillAlpha="0.88"
        android:pathData="M80.8,72.4 A30,30 0 1,1 122.8,128.0 A38,38 0 0,0 80.8,72.4 Z"/>

    <!-- 金新月 = 从交点1沿你圆弧到交点2（大弧），再沿Aura圆弧反向回交点1 -->
    <path android:fillColor="@color/brand_aura_gold" android:fillAlpha="0.58"
        android:pathData="M80.8,72.4 A38,38 0 1,1 122.8,128.0 A30,30 0 0,0 80.8,72.4 Z"/>

</vector>
