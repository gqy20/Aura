{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web/apps/web && corepack pnpm build",
  "installCommand": "corepack enable && corepack prepare pnpm@10.13.1 --activate && cd web && corepack pnpm install --frozen-lockfile",
  "outputDirectory": "web/apps/web/.next",
  "framework": "nextjs",
  "regions": ["hkg1"],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "master": true
    }
  },
  "github": {
    "silent": false,
    "autoAlias": true
  }
}
